# OpenAI-compatible LLM configuration. Never commit the real .env file.
LLM_ENABLED=true
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k3
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=32768
KIMI_K3_MIN_TOKENS=2048
# C11.3 cluster read-only preflight.
CLUSTER_PREFLIGHT_ENABLED=false

CLUSTER_SSH_HOST=login.example.edu.cn
CLUSTER_SSH_PORT=22
CLUSTER_SSH_USER=replace-with-cluster-user

CLUSTER_SSH_KEY_PATH=C:/Users/your-name/.ssh/cluster_key
CLUSTER_SSH_KNOWN_HOSTS=C:/Users/your-name/.ssh/known_hosts
CLUSTER_CONNECT_TIMEOUT_SECONDS=20

CLUSTER_REMOTE_ROOT=/work/home/your-name/catalyst-agent
CLUSTER_SLURM_PARTITION=replace-with-partition

CLUSTER_VASP_MODULE=replace-with-vasp-module
CLUSTER_VASP_EXECUTABLE=vasp_std
CLUSTER_VASP_COMMAND=srun vasp_std

CLUSTER_REMOTE_WRITE_ENABLED=false
CLUSTER_SUBMISSION_ENABLED=false
# Extra browser safety switch. All three switches must be true for web upload/submission.
WEB_REMOTE_OPERATIONS_ENABLED=false
CLUSTER_REMOTE_RUNS_ROOT=/work/home/your-user/catalyst-agent/runs
CLUSTER_SLURM_SCRIPT_NAME=vasp.slurm
CLUSTER_REMOTE_OPERATION_TIMEOUT_SECONDS=120
# Crossref polite-pool contact. Use a real ASCII email or leave empty.
CROSSREF_MAILTO=
# Optional key; anonymous Semantic Scholar requests have stricter rate limits.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=30
# OpenAlex is retained only as inactive compatibility code.
OPENALEX_ENABLED=false

# Open one interactive PowerShell monitor after successful Slurm submission.
JOB_MONITOR_AUTO_OPEN=true
JOB_MONITOR_INTERVAL_SECONDS=60

# Only used by docker-compose.hpc.yml; host files are mounted read-only.
CLUSTER_SSH_KEY_HOST_PATH=C:/Users/your-name/.ssh/cluster_key
CLUSTER_KNOWN_HOSTS_HOST_PATH=C:/Users/your-name/.ssh/known_hosts
VASP_PBE_HOST_PATH=C:/path/to/your/licensed/VASP/PBE
